{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bruiser-gateway.com/protocol/policy.schema.json",
  "title": "Bruiser policy document",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "merchant": { "type": "string" },
    "defaults": {
      "type": "object",
      "properties": {
        "lease_ttl": { "type": "string" },
        "max_lifetime": { "type": "string" },
        "session_ttl": { "type": "string" },
        "principal_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "match": {
            "type": "object",
            "properties": {
              "action": { "type": "array", "items": { "type": "string" } },
              "resource_prefix": { "type": "string" }
            }
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(customer|resource|resource_pool|principal_type|anchor:.+)$"
            }
          },
          "max_active": { "type": "integer", "minimum": 1 },
          "lease_ttl": { "type": "string" },
          "max_lifetime": { "type": "string" },
          "precedence": { "type": "array", "items": { "type": "string" } },
          "control": { "enum": ["none"] },
          "on_missing_anchor": { "enum": ["deny", "fallthrough"] }
        }
      }
    },
    "fallback": { "enum": ["deny", "allow-uncontrolled"] }
  }
}

# Copy to .env (gitignored). Do not commit real secrets.
# Empty values and "change-me*" fail production ValidateSecrets (Fix 2).
# Lab: `make serve` / `make demo-up` inject lab secrets from the Makefile.
# Production: generate unique values (openssl rand -base64 32).
# Harchester Compose demo: scripts/demo-up-local.sh and docker-compose.demo.yml
# set BRUISER_ENV=lab plus the lab secrets below.

BRUISER_ENV=lab
BRUISER_DATABASE_URL=postgres://bruiser:bruiser@127.0.0.1:5432/bruiser?sslmode=disable
BRUISER_TEST_DATABASE_URL=postgres://bruiser:bruiser@127.0.0.1:5432/bruiser_test?sslmode=disable
BRUISER_HTTP_ADDR=:8080
BRUISER_ADMIN_ADDR=127.0.0.1:8082
BRUISER_MERCHANT_ID=arsenal
BRUISER_MERCHANT_NAME=Arsenal FC
BRUISER_PROFILE=configs/arsenal.yaml
BRUISER_PROXY_ADDR=:8081
BRUISER_ORIGIN_URL=http://127.0.0.1:8090
BRUISER_MAX_IN_FLIGHT=2
BRUISER_RATE_PER_SEC=5

BRUISER_ADMIN_SECRET=change-me
BRUISER_OPERATOR_SECRET=change-me
BRUISER_EDGE_SECRET=change-me
BRUISER_ORIGIN_SECRET=change-me
BRUISER_DEV_HMAC_SECRET=change-me

SIMTIX_HTTP_ADDR=:8090
SIMTIX_EDGE_ADDR=:8091
SIMTIX_BRUISER_URL=http://127.0.0.1:8080
SIMTIX_ORIGIN_SECRET=change-me

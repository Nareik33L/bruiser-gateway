# Origin routing for the Harchester Compose demo (on the VM).
# Public hosting puts Cloudflare DNS + proxy in front of this origin.
# Optional Cloudflare Access belongs on the admin hostname, not here.
# Gateway and load-lab stay unpublished.

harchester.localhost {
	reverse_proxy harchester:8100
}
tickets.localhost {
	reverse_proxy simtix:8091
}
admin.localhost {
	reverse_proxy admin:8110
}
